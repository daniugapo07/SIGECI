# Configuración de Flask
# Copia este archivo a .env y completa los valores reales.
# Nunca subas el archivo .env a un repositorio (contiene claves sensibles).

FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cambiar-esta-clave-en-produccion

# Llave de API de Gemini (PEGA TU LLAVE REAL AQUÍ)
GEMINI_API_KEY=TU_LLAVE_DE_GEMINI_AQUI

# Configuración de la app
APP_NAME=SIGECI

# Credenciales de acceso (leídas por el controlador, sin base de datos)
APP_USUARIO=TU_USUARIO
APP_CLAVE=TU_CLAVE

# Configuración de Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=cambiar-esta-clave-en-produccion

# Llave de API de Gemini (pega tu llave aquí)
GEMINI_API_KEY=TU_LLAVE_DE_GEMINI_AQUI

# Configuración de la app
APP_NAME=SIGECI

# Credenciales de acceso (leídas por el controlador, sin base de datos)
APP_USUARIO=admon
APP_CLAVE=clave123
